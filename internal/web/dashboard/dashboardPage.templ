package dashboard

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"journal/internal/web"
	"journal/internal/web/actionItems"
	"journal/internal/web/components"
	"journal/internal/web/journal"
)

func getOutstandingActionItems(c *fiber.Ctx) []*models.ActionItem {
	actionItems := utils.GetLocal[[]*models.ActionItem](c, "outstandingActionItems")
	if actionItems != nil {
		return *actionItems
	}
	return []*models.ActionItem{}
}

// patternDef is one entry on the Patterns tab: a title/description for its
// accordion plus the chart component itself, keyed so a user can opt out of
// it individually (see dashboardPreferences in the dashboard controller,
// which persists hidden keys to User.Metadata).
type patternDef struct {
	Key         string
	Title       string
	Description string
	Chart       templ.Component
}

// PatternKeys is the canonical list of valid pattern keys, used by the
// dashboard controller to validate the :key route param on hide/show.
var PatternKeys = []string{
	"calendar", "moodByDay", "moodChart", "moodVsThankfulness",
	"moodVsActionCompletion", "moodByTopic", "frequencyChart", "moodByTod",
	"thankfulFrequency", "distByTopic", "routineCompletion",
}

func IsValidPatternKey(key string) bool {
	for _, k := range PatternKeys {
		if k == key {
			return true
		}
	}
	return false
}

func allPatternDefs(c *fiber.Ctx) []patternDef {
	defs := []patternDef{
		{
			Key:   "calendar",
			Title: "The Calendar",
			Description: "A quick look at how your days have felt over time without having to read back through anything. " +
				"Patterns tend to emerge that you might not notice day to day; a rough stretch, a good week, how things have shifted over months.",
			Chart: RatingCalendar(c),
		},
		{
			Key:   "moodByDay",
			Title: "Average Rating by Day",
			Description: "Some days of the week just tend to feel different than others. This might show you that your Mondays are rougher than you thought, " +
				"or that your weekends aren't as good as you'd expect. The 7, 30, and 90 day ranges let you see whether those patterns are consistent over time or just a recent thing.",
			Chart: MoodByDay(c),
		},
		{
			Key:   "moodChart",
			Title: "Rating Flow",
			Description: "The same mood data as the calendar but stretched out as a line, which makes it easier to see momentum. " +
				"Whether things have been trending up, down, or just kind of flat. A single bad day looks different when you can see what was on either side of it.",
			Chart: MoodChart(c),
		},
		{
			Key:   "moodVsThankfulness",
			Title: "Rating vs Thankfulness",
			Description: "On days where you took a moment to note something worth being grateful for, did it actually make a difference? This tries to show that, " +
				"comparing the average mood of entries with at least one thankful against those without, grouped by rating. It won't always show a clear pattern, " +
				"and that's okay. Sometimes it just reflects that you're good at finding gratitude even on hard days.",
			Chart: MoodVsThankfulness(c),
		},
		{
			Key:   "moodVsActionCompletion",
			Title: "Rating vs Action Completion",
			Description: "On days where you checked something off, did things feel any different? This compares the average mood of entries on days with at least one " +
				"completed action against those without. The pattern won't always be dramatic. Sometimes it just means you're getting things done regardless of how you feel, " +
				"which is its own kind of useful to see.",
			Chart: MoodVsActionCompletion(c),
		},
		{
			Key:   "moodByTopic",
			Title: "Rating by Topic",
			Description: "Different areas of life don't always feel the same. This shows your average rating per topic over the selected time range, which can surface " +
				"things you might not have noticed: that work entries consistently rate lower than everything else, or that the topics you write about least are actually the ones that feel best.",
			Chart: MoodByTopic(c),
		},
		{
			Key:   "frequencyChart",
			Title: "Entries per Day",
			Description: "A look at how often you've been writing. Less about consistency as a goal and more about noticing your own patterns: when you tend to write more, " +
				"whether busy or difficult stretches show up as gaps, and how that's shifted over time.",
			Chart: FrequencyChart(c),
		},
		{
			Key:   "moodByTod",
			Title: "Rating by Time of Day",
			Description: "Whether the time you write has any relationship to how you're feeling. Morning entries might rate differently than late night ones, or there might " +
				"be no pattern at all, but if there is one, it's the kind of thing you'd probably never notice just from writing.",
			Chart: MoodByTod(c),
		},
		{
			Key:   "thankfulFrequency",
			Title: "Thankfuls per Day",
			Description: "Tracks how often you're jotting down things worth being grateful for. Less about hitting a number and more about noticing whether the habit is " +
				"forming, fading, or just inconsistent in ways that might be interesting.",
			Chart: ThankfulFrequencyChart(c),
		},
		{
			Key:   "distByTopic",
			Title: "What You're Writing About",
			Description: "Which parts of your life are taking up the most space in your journal lately. Sometimes the distribution is what you'd expect, sometimes it isn't, " +
				"and noticing that you've been writing almost entirely about work, or that you haven't touched a topic in months, can be worth knowing.",
			Chart: DistByTopic(c),
		},
	}
	if web.CurrentUser(c).HasFeature("routines") {
		defs = append(defs, patternDef{
			Key:   "routineCompletion",
			Title: "Routine Completion",
			Description: "A non-judgmental look at how consistently you've been following through on your recurring actions. The rolling window is intentional. A rough " +
				"week doesn't define the whole month, and a good stretch can show up even if things fell apart for a while. Less about holding yourself accountable and more about just knowing where things actually stand.",
			Chart: RoutineCompletionRate(c),
		})
	}
	return defs
}

func getHiddenPatterns(c *fiber.Ctx) map[string]bool {
	hidden := utils.GetLocal[map[string]bool](c, "hiddenPatterns")
	if hidden == nil {
		return map[string]bool{}
	}
	return *hidden
}

func visiblePatternDefs(c *fiber.Ctx) []patternDef {
	hidden := getHiddenPatterns(c)
	visible := []patternDef{}
	for _, p := range allPatternDefs(c) {
		if !hidden[p.Key] {
			visible = append(visible, p)
		}
	}
	return visible
}

func hiddenPatternDefs(c *fiber.Ctx) []patternDef {
	hidden := getHiddenPatterns(c)
	result := []patternDef{}
	for _, p := range allPatternDefs(c) {
		if hidden[p.Key] {
			result = append(result, p)
		}
	}
	return result
}

func pluralSuffix(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

templ Tabs(c *fiber.Ctx) {
	<nav class="tabs">
		<a href="/dashboard?tab=today" class={ "tab", templ.KV("active", c.Query("tab", "today") == "today") }>Today</a>
		<a href="/dashboard?tab=patterns" class={ "tab", templ.KV("active", c.Query("tab") == "patterns") }>Patterns</a>
	</nav>
}

templ Today(c *fiber.Ctx) {
	<h2 class="heading">How are you feeling?</h2>
	@journal.Form(c, nil)
	<br/>
	<h3 class="heading">Here's what's left.</h3>
	@actionItems.Form(c, nil, nil)
	<br/>
	@actionItems.List(c, getOutstandingActionItems(c))
}

templ patternBlock(c *fiber.Ctx, p patternDef) {
	<div class="pattern">
		<div class="pattern-header">
			@components.Accordion(p.Title) {
				{ p.Description }
			}
			<button
				class="button"
				aria-label={ fmt.Sprintf("Hide %s", p.Title) }
				title="Hide this pattern"
				hx-put={ fmt.Sprintf("/api/dashboard/patterns/%s/hide", p.Key) }
				hx-swap="none"
			>
				<i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
			</button>
		</div>
		@p.Chart
	</div>
}

templ hiddenPatternsManager(c *fiber.Ctx) {
	<details class="hidden-patterns">
		<summary>
			{ fmt.Sprintf("%d pattern%s hidden", len(hiddenPatternDefs(c)), pluralSuffix(len(hiddenPatternDefs(c)))) }
		</summary>
		<ul>
			for _, p := range hiddenPatternDefs(c) {
				<li>
					<span>{ p.Title }</span>
					<button
						class="button"
						hx-put={ fmt.Sprintf("/api/dashboard/patterns/%s/show", p.Key) }
						hx-swap="none"
					>
						Show
					</button>
				</li>
			}
		</ul>
	</details>
}

templ Patterns(c *fiber.Ctx) {
	for _, p := range visiblePatternDefs(c) {
		@patternBlock(c, p)
		<br/>
	}
	if len(hiddenPatternDefs(c)) > 0 {
		@hiddenPatternsManager(c)
	}
}

templ DashboardPage(c *fiber.Ctx) {
	@web.Base(c, nil) {
		<div id="dashboard-page">
			@Tabs(c)
			if c.Query("tab", "today") == "today" {
				@Today(c)
			}
			if c.Query("tab") == "patterns" {
				@Patterns(c)
			}
		</div>
	}
}
