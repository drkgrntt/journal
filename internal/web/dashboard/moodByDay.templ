package dashboard

import (
	"github.com/gofiber/fiber/v2"
	"journal/internal/web/components"
)

templ MoodByDayContent(c *fiber.Ctx) {
	@components.TimespanFieldset("/dashboard/mood-by-day", "", "days", "#mood-by-day", c.QueryInt("days", 30))
	<div class="mood-by-day">
		@templ.JSONScript("mood-by-day-data", c.Locals("moodByDayData"))
		@templ.JSONScript("mood-by-day-ratings-data", c.Locals("ratings"))
		<script src="/assets/js/components/moodByDay.js" type="module" onload="document.dispatchEvent(new Event('load-mood-by-day'))"></script>
	</div>
}

templ MoodByDay(c *fiber.Ctx) {
	<div
		id="mood-by-day"
		hx-get="/dashboard/mood-by-day"
		hx-trigger="load"
		hx-target="#mood-by-day"
		hx-swap="innerHTML"
	></div>
}
