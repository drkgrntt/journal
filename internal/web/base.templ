package web

import "github.com/gofiber/fiber/v2"
import "fmt"

func id(c *fiber.Ctx) string {
	user := CurrentUser(c)
	if user == nil {
		return ""
	}
	return user.ID.String()
}

type Head struct {
	Title       string
	Description string
}

func DefaultHead() *Head {
	return &Head{
		Title:       "A Journal for Noticing Patterns",
		Description: "Contour Journal is a private journaling app for tracking mood, routines, and patterns over time.",
	}
}

templ Base(c *fiber.Ctx, head *Head) {
	@baseWithHead(c, resolveHead(head)) {
		{ children... }
	}
}

func resolveHead(h *Head) *Head {
	if h == nil {
		return DefaultHead()
	}
	return h
}

templ baseWithHead(c *fiber.Ctx, h *Head) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Contour Journal - { h.Title }</title>
			<meta name="og:title" content={ fmt.Sprintf("Contour Journal - %s", h.Title) }/>
			<meta name="description" content={ h.Description }/>
			<meta name="theme-color" id="theme-color-meta" content="#ffffff"/>
			<script src={ AssetURL("/assets/js/theme.js") }></script>
			<link href={ AssetURL("/assets/fontawesome/css/fontawesome.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/solid.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/regular.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/sharp-thin.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/css/output.css") } rel="stylesheet"/>
			<link rel="icon" type="image/png" href="/assets/images/icon-192.png"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<script src={ AssetURL("/assets/js/index.js") } type="module"></script>
			<script src={ AssetURL("/assets/js/lib/htmx.min.js") }></script>
			<script src={ AssetURL("/assets/js/lib/chart.min.js") }></script>
			<script>
				// Chart.js's own default tick/legend/grid color is a fixed dark
				// gray, so it goes near-invisible on a dark surface. Match
				// whichever theme is actually in effect (assets/js/theme.js,
				// loaded above) - the chart components (assets/js/components/
				// *Chart.js) only set per-dataset colors, not axis/legend text.
				if (window.Chart && currentEffectiveTheme() === "dark") {
					var themeStyle = getComputedStyle(document.documentElement);
					Chart.defaults.color = themeStyle.getPropertyValue("--text-secondary-color").trim();
					Chart.defaults.borderColor = themeStyle.getPropertyValue("--border-color").trim();
				}
			</script>
		</head>
		<body id={ id(c) }>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			@Header(c)
			<main
				id="main-content"
				class="main"
				hx-on:htmx:after-request="handleHtmxError?.(event)"
			>
				@Nav(c)
				{ children... }
			</main>
			@Footer(c)
		</body>
	</html>
}
