package web

import "github.com/gofiber/fiber/v2"
import "fmt"

func id(c *fiber.Ctx) string {
	user := CurrentUser(c)
	if user == nil {
		return ""
	}
	return user.ID.String()
}

type Head struct {
	Title       string
	Description string
}

func DefaultHead() *Head {
	return &Head{
		Title:       "A Journal for Noticing Patterns",
		Description: "Contour Journal is a private journaling app for tracking mood, routines, and patterns over time.",
	}
}

templ Base(c *fiber.Ctx, head *Head) {
	@baseWithHead(c, resolveHead(head)) {
		{ children... }
	}
}

// appearanceOf is the palette and font to render: the user's saved choice if
// their plan is active, the defaults otherwise (and for logged-out pages).
func appearanceOf(c *fiber.Ctx) (string, string) {
	user := CurrentUser(c)
	if user == nil {
		return "", ""
	}
	return user.EffectiveAppearance()
}

// viewportContent lets the native shell's page (and the signed-in tab bar) draw under the system bars
// (viewport-fit=cover); the header and footer then pad themselves by the
// safe-area insets (see components/header.css and footer.css) so their own
// background fills the bar areas in whichever theme is active.
func viewportContent(c *fiber.Ctx) string {
	if IsNativeApp(c) || ShowTabBar(c) {
		return "width=device-width, initial-scale=1.0, viewport-fit=cover"
	}
	return "width=device-width, initial-scale=1.0"
}

func resolveHead(h *Head) *Head {
	if h == nil {
		return DefaultHead()
	}
	return h
}

templ baseWithHead(c *fiber.Ctx, h *Head) {
	<!DOCTYPE html>
	<html
		lang="en"
		if palette, _ := appearanceOf(c); palette != "" {
			data-palette={ palette }
		}
		if _, font := appearanceOf(c); font != "" {
			data-font={ font }
		}
		if CurrentUser(c) != nil {
			data-appearance-sync
		}
		if IsNativeApp(c) {
			data-native-app
		}
		if ShowTabBar(c) {
			data-tab-bar
		}
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content={ viewportContent(c) }/>
			<title>Contour Journal - { h.Title }</title>
			<meta name="og:title" content={ fmt.Sprintf("Contour Journal - %s", h.Title) }/>
			<meta name="description" content={ h.Description }/>
			<meta name="theme-color" id="theme-color-meta" content="#ffffff"/>
			<script src={ AssetURL("/assets/js/theme.js") }></script>
			<link href={ AssetURL("/assets/fontawesome/css/fontawesome.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/solid.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/regular.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/fontawesome/css/sharp-thin.css") } rel="stylesheet"/>
			<link href={ AssetURL("/assets/css/output.css") } rel="stylesheet"/>
			<link rel="icon" type="image/png" href="/assets/images/icon-192.png"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<link rel="apple-touch-icon" href="/assets/images/icon-192.png"/>
			<meta name="mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Contour"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<script src={ AssetURL("/assets/js/index.js") } type="module"></script>
			<script src={ AssetURL("/assets/js/lib/htmx.min.js") }></script>
			<script src={ AssetURL("/assets/js/lib/chart.min.js") }></script>
			<script>
				// Chart.js defaults follow the active theme (assets/js/theme.js,
				// loaded above); the chart components only set per-dataset colors.
				applyChartDefaults();
			</script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to main content</a>
			@Header(c)
			@GraceBanner(c)
			<main
				id="main-content"
				class="main"
				data-user-id={ id(c) }
				hx-on:htmx:after-request="handleHtmxError?.(event)"
			>
				@Nav(c)
				{ children... }
			</main>
			@Footer(c)
			@TabBar(c)
			<dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-message">
				<form method="dialog">
					<p id="confirm-message" confirm-message></p>
					<div class="actions">
						<button type="submit" value="cancel" confirm-cancel>Cancel</button>
						<button type="submit" value="ok" confirm-ok>Confirm</button>
					</div>
				</form>
			</dialog>
		</body>
	</html>
}
