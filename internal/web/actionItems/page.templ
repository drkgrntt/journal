package actionItems

import (
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"journal/internal/web"
	"journal/internal/web/recurringActionItems"
)

func getRecurringActionItems(c *fiber.Ctx) []*models.RecurringActionItem {
	recurringActionItems := utils.GetLocal[[]*models.RecurringActionItem](c, utils.LocalRecurringActionItems)
	if recurringActionItems == nil {
		return []*models.RecurringActionItem{}
	}
	return *recurringActionItems
}

templ Page(c *fiber.Ctx) {
	@web.Base(c, nil) {
		<div id="action-item-list-page">
			if web.CurrentUser(c).IsSubscribed() || len(getRecurringActionItems(c)) > 0 {
				<h2 class="heading">Routines</h2>
				@recurringActionItems.List(c, getRecurringActionItems(c))
				if web.CurrentUser(c).IsSubscribed() {
					@recurringActionItems.Form(c, nil)
				} else {
					<p>Routines are resting. They'll pick up where they left off whenever your plan does.</p>
				}
			}
			<h2 class="heading">Actions</h2>
			@listPageFilters(c)
			@Form(c, nil, nil)
			@List(c, getActionItems(c), true)
		</div>
	}
}
