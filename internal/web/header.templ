package web

import "github.com/gofiber/fiber/v2"

// homeHref sends a signed-in user to their dashboard (the app's real
// "home") and everyone else to the marketing landing page at "/" -
// mirrors the same CurrentUser branch Nav already uses to decide what a
// logged-in vs. logged-out visitor should see.
func homeHref(c *fiber.Ctx) string {
	if CurrentUser(c) != nil {
		return "/dashboard"
	}
	return "/"
}

templ Header(c *fiber.Ctx) {
	<header class="top-bar">
		<h1 class="heading">
			<a class="brand-link" href={ templ.SafeURL(homeHref(c)) }>
				<span class="title">
					Contour Journal
				</span>
				<span class="subtitle">
					The shape of your mind
				</span>
			</a>
		</h1>
		<button
			type="button"
			class="theme-toggle"
			onclick="toggleTheme()"
			aria-label="Switch between light and dark theme"
			title="Switch between light and dark theme"
		>
			<i class="fa-solid fa-sun" aria-hidden="true"></i>
			<i class="fa-solid fa-moon" aria-hidden="true"></i>
		</button>
	</header>
}
