package landings

import (
	"github.com/gofiber/fiber/v2"
	"journal/internal/web"
)

templ FeedbackPage(c *fiber.Ctx) {
	@web.Base(c, &web.Head{Title: "Feedback"}) {
		<div id="feedback-page" class="landing">
			<h2 class="heading">Feedback</h2>
			<p>Whether you ran into something broken, have an idea, or just want to share how the journal has been useful to you -- this is the place. The email field is optional and only needed if you'd like a response. Either way, someone actually reads these.</p>
			<form
				class="form"
				hx-post="/api/feedback"
			>
				<div class="field">
					<input
						class="input"
						type="email"
						name="email"
						id="email"
					/>
					<label class="label" for="email">
						Email (only if you'd like a reply)
					</label>
				</div>
				<div class="field">
					<textarea
						class="textarea"
						name="message"
						id="message"
						rows="10"
					></textarea>
					<label class="label" for="message">Message</label>
				</div>
				<input class="button" type="submit" value="Submit"/>
			</form>
		</div>
	}
}
