package landings

import (
	"github.com/gofiber/fiber/v2"
	"journal/internal/web"
)

templ LandingPage(c *fiber.Ctx) {
	@web.Base(c) {
		<div id="landing-page">
			<header>
				<h1>A journal that helps you notice patterns</h1>
				<p>
					Write freely, rate your day, capture small actions and gratitude —
					and see how it all connects over time.
				</p>
				<a class="cta" href="/auth/register">Start journaling</a>
			</header>
			<!-- Problem -->
			<section>
				<h2>Journaling doesn’t usually fail because writing isn’t helpful</h2>
				<p>
					It fails because it’s hard to see what your entries add up to.
					This journal is designed to turn reflection into insight,
					without demanding consistency or perfection.
				</p>
			</section>
			<!-- Features -->
			<section>
				<h2>How it works</h2>
				<div class="features">
					<div class="feature">
						<h3>📝 Freeform entries</h3>
						<p>
							Write as much or as little as you want. One sentence or several
							paragraphs both count.
						</p>
					</div>
					<div class="feature">
						<h3>⭐ Simple ratings & topics</h3>
						<p>
							Each entry gets a quick rating and a topic, unlocking patterns
							without interrupting your flow.
						</p>
					</div>
					<div class="feature">
						<h3>✅ Actions</h3>
						<p>
							Add small, concrete steps alongside your writing. Reflection is
							useful — action makes it stick.
						</p>
					</div>
					<div class="feature">
						<h3>🙏 Thankful notes</h3>
						<p>
							Capture what’s worth noticing. Gratitude without ceremony or pressure.
						</p>
					</div>
					<div class="feature">
						<h3>📊 Pattern-focused views</h3>
						<p>
							Calendar and charts help you see trends between mood, actions,
							and gratitude over time.
						</p>
					</div>
				</div>
			</section>
			<!-- Philosophy / Privacy -->
			<section>
				<div class="philosophy">
					<h2>Privacy-first, intentionally</h2>
					<p>
						All freeform text — journal entries, actions, and thankful notes —
						is encrypted at rest.
					</p>
					<p>
						There are no ads, no tracking for marketing, and no data mining.
						Your journal is yours.
					</p>
					<p>
						The goal is a calm, sustainable tool that respects your attention
						and your data.
					</p>
				</div>
			</section>
			<!-- Who it's for -->
			<section>
				<h2>Is this for you?</h2>
				<div class="for-who">
					<div>
						<h3>Probably yes, if:</h3>
						<ul>
							<li>You want insight, not just storage</li>
							<li>You like simple tools that don’t demand daily streaks</li>
							<li>You care about privacy and ownership</li>
						</ul>
					</div>
					<div>
						<h3>Probably not, if:</h3>
						<ul>
							<li>You want heavy prompts or guided therapy</li>
							<li>You want social sharing or gamification</li>
							<li>You want productivity metrics first and reflection second</li>
						</ul>
					</div>
				</div>
			</section>
			<!-- Closing CTA -->
			<section style="text-align: center;">
				<h2>If you’ve ever wanted journaling to add up to something</h2>
				<p style="padding-bottom: 1rem;">
					This might be worth trying.
				</p>
				<a class="cta" href="/auth/register">Create an account</a>
			</section>
		</div>
	}
}
