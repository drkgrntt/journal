package web

import "github.com/gofiber/fiber/v2"

templ Nav(c *fiber.Ctx) {
	<input
		onchange="document.getElementById('app-nav').classList.toggle('open')"
		id="nav-toggle"
		class="toggle"
		type="checkbox"
	/>
	<div class="toggle-button-border">
		<label class="toggle-button" for="nav-toggle">
			<span>Toggle nav menu</span>
		</label>
	</div>
	<nav id="app-nav">
		<ul class="list">
			if CurrentUser(c) != nil {
				<li class="list-item"><a class="link" href="/dashboard">Dashboard</a></li>
				<li class="list-item"><a class="link" href="/journal">Journal</a></li>
				<li class="list-item"><a class="link" href="/journal/new">Write</a></li>
				<li class="list-item"><a class="link" href="/action-items">Actions</a></li>
				<li class="list-item"><a class="link" href="/reminders">Reminders</a></li>
				<li class="list-item"><a class="link" href="/profile">Profile</a></li>
				<li class="list-item">
					<a
						class="link"
						href="#"
						hx-post="/api/auth/logout"
					>Logout</a>
				</li>
			} else {
				<li class="list-item"><a class="link" href="/auth/login">Sign in</a></li>
				<li class="list-item"><a class="link" href="/auth/register">Sign up</a></li>
			}
		</ul>
		if CurrentUser(c) != nil {
			// The footer is hidden on phones when the tab bar is showing
			// (components/tabBar.css), so its links live here instead.
			<ul class="list list-secondary">
				if !IsNativeApp(c) {
					<li class="list-item"><a class="link" href="/about">About</a></li>
					<li class="list-item"><a class="link" href="/blog">Blog</a></li>
				}
				<li class="list-item"><a class="link" href="/privacy">Privacy</a></li>
				<li class="list-item"><a class="link" href="/feedback">Feedback</a></li>
			</ul>
		}
	</nav>
}
