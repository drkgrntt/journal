package profile

import (
	"fmt"
	"time"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/stripe"
	"journal/internal/web"
	"journal/internal/web/customJournalTypes"
)

templ infoForm(c *fiber.Ctx) {
	<form
		class="form"
		hx-put="/api/profile"
		hx-swap="none"
		hx-on::after-request="handleHtmxSuccess(event, 'Saved!')"
	>
		<div class="field">
			<label for="email" class="label">Email</label>
			<input
				class="input"
				type="email"
				name="email"
				id="email"
				value={ web.CurrentUser(c).Email }
				disabled
			/>
		</div>
		<div class="field">
			<label for="firstName" class="label">First Name</label>
			<input
				class="input"
				name="firstName"
				id="firstName"
				value={ web.CurrentUser(c).FirstName }
			/>
		</div>
		<div class="field">
			<label for="lastName" class="label">Last Name</label>
			<input
				class="input"
				name="lastName"
				id="lastName"
				value={ web.CurrentUser(c).LastName }
			/>
		</div>
		<div class="field">
			<button
				type="submit"
				class="button"
			>
				Save
			</button>
		</div>
	</form>
}

templ passwordForm(c *fiber.Ctx) {
	<form
		class="form"
		hx-put="/api/profile/password"
		hx-swap="none"
		hx-on::after-request="handleHtmxSuccess(event, 'Saved!');this.reset();"
	>
		<div class="field">
			<label for="currentPassword" class="label">Current Password</label>
			<input
				class="input"
				type="password"
				name="currentPassword"
				id="currentPassword"
			/>
		</div>
		<div class="field">
			<label for="newPassword" class="label">New Password</label>
			<input
				class="input"
				type="password"
				name="newPassword"
				id="newPassword"
			/>
		</div>
		<div class="field">
			<label for="confirmNewPassword" class="label">Confirm New Password</label>
			<input
				class="input"
				type="password"
				name="confirmNewPassword"
				id="confirmNewPassword"
			/>
		</div>
		<div class="field">
			<button
				type="submit"
				class="button"
			>
				Change Password
			</button>
		</div>
	</form>
}

func formatDate(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("January 2, 2006")
}

// planStatus is the plain-language line about where the user's plan stands.
func planStatus(user *models.User) string {
	end := formatDate(user.AccessEndsAt())
	switch user.SubscriptionStatus {
	case models.SubscriptionComped:
		return "Everything is on for this account."
	case models.SubscriptionLifetime:
		return "You have a lifetime plan. Thank you."
	case models.SubscriptionPastDue:
		return "There was a problem with your last payment. You can update it from Manage plan, and everything stays on in the meantime."
	}
	if user.IsSubscribed() && !user.InGracePeriod() {
		if user.SubscriptionStatus == models.SubscriptionTrialing {
			return fmt.Sprintf("Everything is on while you try it, through %s.", end)
		}
		if end != "" {
			return fmt.Sprintf("Your plan is active through %s.", end)
		}
		return "Your plan is active."
	}
	if user.InGracePeriod() {
		return fmt.Sprintf("Your plan ended on %s. Everything stays on for a couple more weeks, then the extras rest. What you've written is never touched.", end)
	}
	return "The extras are resting. What you've written is untouched, and they'll pick up where they left off whenever you want them back."
}

func hasPlanToManage(user *models.User) bool {
	switch user.SubscriptionStatus {
	case models.SubscriptionActive, models.SubscriptionPastDue:
		return true
	}
	return false
}

func canChoosePlan(user *models.User) bool {
	switch user.SubscriptionStatus {
	case models.SubscriptionActive, models.SubscriptionPastDue, models.SubscriptionLifetime, models.SubscriptionComped:
		return false
	}
	return true
}

templ planSection(c *fiber.Ctx) {
	<div class="form plan">
		<h4>Plan</h4>
		if c.Query("checkout") == "success" {
			<p>Thank you. It can take a moment for your plan to show up here.</p>
		}
		<p>{ planStatus(web.CurrentUser(c)) }</p>
		<p>The plan includes Routines, Custom Topics, Themes, Entry Templates, and a daily reminder email.</p>
		if hasPlanToManage(web.CurrentUser(c)) {
			<div class="field">
				<button class="button" hx-post="/api/profile/billing/portal" hx-swap="none">Manage plan</button>
			</div>
		}
		if hasPlanToManage(web.CurrentUser(c)) {
			<div class="field">
				<button
					class="button"
					hx-post={ fmt.Sprintf("/api/profile/billing/checkout/%s", stripe.PlanLifetime) }
					hx-swap="none"
					hx-confirm="Switch to a lifetime plan? Your current plan ends once the payment goes through, and the time left on it isn't credited."
				>
					Switch to Lifetime &middot; { stripe.PlanLabel(stripe.PlanLifetime) }
				</button>
			</div>
		}
		if canChoosePlan(web.CurrentUser(c)) {
			<div class="field plan-options">
				for _, plan := range stripe.Plans {
					if label := stripe.PlanLabel(plan); label != "" {
						<button
							class="button"
							hx-post={ fmt.Sprintf("/api/profile/billing/checkout/%s", plan) }
							hx-swap="none"
						>
							{ planName(plan) } &middot; { label }
						</button>
					}
				}
			</div>
		}
	</div>
}

func planName(plan stripe.Plan) string {
	switch plan {
	case stripe.PlanMonthly:
		return "Monthly"
	case stripe.PlanAnnual:
		return "Annual"
	}
	return "Lifetime"
}

templ blurTextToggle(c *fiber.Ctx) {
	<div class="checkField">
		<input
			type="checkbox"
			id={ fmt.Sprintf("blur-text-%s", web.CurrentUser(c).ID.String()) }
			onchange="localStorage.setItem(this.id, this.checked)"
		/>
		<script>
			document.getElementById('{{ fmt.Sprintf("blur-text-%s", web.CurrentUser(c).ID.String()) }}').checked = localStorage.getItem('{{ fmt.Sprintf("blur-text-%s", web.CurrentUser(c).ID.String()) }}') === 'true'
		</script>
		<label for={ fmt.Sprintf("blur-text-%s", web.CurrentUser(c).ID.String()) }>Blur Sensitive Text</label>
	</div>
}

templ exportSection(c *fiber.Ctx) {
	<div class="form">
		<h4>Export Your Journal</h4>
		<p>Download everything you've written — for backup, or to use elsewhere.</p>
		<div class="field">
			<a class="button" href="/api/profile/export?format=markdown" download>Export as Markdown</a>
			<a class="button" href="/api/profile/export?format=json" download>Export as JSON</a>
		</div>
	</div>
}

templ customJournalTypeForm(c *fiber.Ctx) {
	<div class="form">
		<h4>Custom Topics</h4>
		if web.CurrentUser(c).IsSubscribed() {
			@customJournalTypes.Form(c, nil)
		} else {
			<p>Creating new topics is part of the plan; the ones you have stay as they are.</p>
		}
		@customJournalTypes.List(c, web.CurrentUser(c).CustomJournalTypes)
	</div>
}

templ appearanceSection(c *fiber.Ctx) {
	{{ user := web.CurrentUser(c) }}
	<form
		class="form"
		hx-put="/api/profile/appearance"
		hx-swap="none"
		hx-on::after-request="if (!event.detail.failed) { setAppearance(this.elements.theme.value, this.elements.fontFamily.value); handleHtmxSuccess(event, 'Saved!') }"
	>
		<h4>Appearance</h4>
		if !user.IsSubscribed() {
			<p>Colors and fonts are part of the plan; your choice is kept for whenever it's back.</p>
		}
		<fieldset class="field" disabled?={ !user.IsSubscribed() }>
			<legend class="label legend">Color</legend>
			<div class="appearance-swatches">
				for _, option := range appearanceThemes {
					<label>
						<input
							type="radio"
							name="theme"
							value={ option.Value }
							aria-label={ option.Label }
							checked?={ user.Theme == option.Value }
						/>
						<span class="swatch" data-palette={ option.Value } title={ option.Label }></span>
					</label>
				}
			</div>
		</fieldset>
		<fieldset class="field" disabled?={ !user.IsSubscribed() }>
			<legend class="label legend">Font</legend>
			<div class="appearance-fonts">
				<div class="check-field">
					<input type="radio" id="font-sans" name="fontFamily" value="" checked?={ user.FontFamily == "" }/>
					<label class="label font-sans" for="font-sans">Sans-serif</label>
				</div>
				<div class="check-field">
					<input type="radio" id="font-serif" name="fontFamily" value="serif" checked?={ user.FontFamily == "serif" }/>
					<label class="label font-serif" for="font-serif">Serif</label>
				</div>
			</div>
		</fieldset>
		if user.IsSubscribed() {
			<div class="field">
				<button type="submit" class="button">Save</button>
			</div>
		}
	</form>
}

var appearanceThemes = []web.LabelValue[string]{
	{Label: "Mint", Value: ""},
	{Label: "Lavender", Value: "lavender"},
	{Label: "Sky", Value: "sky"},
	{Label: "Rose", Value: "rose"},
	{Label: "Sand", Value: "sand"},
}

templ routinesSection(c *fiber.Ctx) {
	<div class="form">
		<h4>Routines</h4>
		<p>Action items that appear on a schedule, like a weekly check-in.</p>
		if !web.CurrentUser(c).IsSubscribed() {
			<p>Creating routines is part of the plan; the ones you have wait quietly until it's back.</p>
		}
		<div class="field">
			<a class="button" href="/action-items">Manage routines</a>
		</div>
	</div>
}

templ entryTemplatesSection(c *fiber.Ctx) {
	<div class="form">
		<h4>Entry Templates</h4>
		<p>Your own starting text for a new entry, like a gentle structure to fill in.</p>
		if !web.CurrentUser(c).IsSubscribed() {
			<p>Using and creating templates is part of the plan; the ones you've saved are kept.</p>
		}
		<div class="field">
			<a class="button" href="/entry-templates">Manage templates</a>
		</div>
	</div>
}

templ reminderEmailSection(c *fiber.Ctx) {
	if web.CurrentUser(c).IsSubscribed() && !web.CurrentUser(c).EmailConfirmed() {
		<div class="form">
			<h4>Reminder Email</h4>
			<p>A quiet daily email inviting you to write. To turn it on, confirm your email first, so it only goes to an address you've confirmed.</p>
			<div class="field">
				<button
					class="button"
					hx-post="/api/profile/confirm-email"
					hx-swap="none"
					hx-on::after-request="if (event.detail.failed) { handleHtmxError(event) } else { handleHtmxSuccess(event, event.detail.xhr.response) }"
				>Send confirmation email</button>
			</div>
		</div>
	} else if web.CurrentUser(c).IsSubscribed() {
		<form
			class="form"
			id="reminder-email-form"
			hx-put="/api/profile/reminder-email"
			hx-swap="none"
			hx-on::after-request="handleHtmxSuccess(event, 'Saved!')"
		>
			<h4>Reminder Email</h4>
			<p>A quiet daily email inviting you to write. Your reminders and entries are never included. Off unless you turn it on.</p>
			<div class="checkField">
				<input
					type="checkbox"
					id="reminderEmailEnabled"
					name="enabled"
					value="true"
					checked?={ web.CurrentUser(c).ReminderEmailEnabled }
				/>
				<label for="reminderEmailEnabled">Send me a reminder email</label>
			</div>
			<div class="field">
				<label for="reminderEmailTime" class="label">Time (your local time)</label>
				<input
					class="input"
					type="time"
					name="time"
					id="reminderEmailTime"
					value={ web.CurrentUser(c).ReminderEmailTime }
					required
				/>
			</div>
			<div class="field">
				<label for="reminderEmailMessage" class="label">Your own message (replaces the default)</label>
				<textarea
					class="input"
					name="message"
					id="reminderEmailMessage"
					maxlength="280"
					rows="2"
					placeholder="Whenever you're ready, the journal is here."
				>{ web.CurrentUser(c).ReminderEmailMessageText() }</textarea>
				<small>Sent by email in plain text, up to 280 characters. Its first line is the subject.</small>
			</div>
			<div class="field">
				<button type="submit" class="button">Save</button>
			</div>
		</form>
	} else if web.CurrentUser(c).ReminderEmailEnabled {
		<form
			class="form"
			hx-put="/api/profile/reminder-email"
			hx-swap="none"
			hx-on::after-request="Promise.resolve(handleHtmxSuccess(event, 'Turned off')).then(() => { if (!event.detail.failed) window.location.reload() })"
		>
			<h4>Reminder Email</h4>
			<p>Reminder emails are paused while your plan is inactive. You can turn them off here.</p>
			<div class="field">
				<button type="submit" class="button">Turn off</button>
			</div>
		</form>	} else {
		<div class="form">
			<h4>Reminder Email</h4>
			<p>A quiet daily email inviting you to write. It's part of the plan, which isn't active right now.</p>
		</div>
	}
}

templ ProfilePage(c *fiber.Ctx) {
	@web.Base(c, nil) {
		<div id="profile-page">
			<h1 class="heading">Profile</h1>
			@blurTextToggle(c)
			<section class="group">
				<h2 class="group-heading">Account</h2>
				<div class="forms">
					@infoForm(c)
					@passwordForm(c)
					@planSection(c)
				</div>
			</section>
			<section class="group">
				<h2 class="group-heading">Extras</h2>
				<div class="forms">
					@appearanceSection(c)
					@routinesSection(c)
					@entryTemplatesSection(c)
					@reminderEmailSection(c)
					@customJournalTypeForm(c)
				</div>
			</section>
			<section class="group">
				<h2 class="group-heading">Your data</h2>
				<div class="forms">
					@exportSection(c)
				</div>
			</section>
		</div>
	}
}
