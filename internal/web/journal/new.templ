package journal

import (
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"journal/internal/web"
	"journal/internal/web/actionItems"
	"journal/internal/web/reminders"
	"journal/internal/web/thankful"
)

func getOutstandingActionItems(c *fiber.Ctx) []*models.ActionItem {
	actionItems := utils.GetLocal[[]*models.ActionItem](c, utils.LocalOutstandingActionItems)
	if actionItems == nil {
		return []*models.ActionItem{}
	}
	return *actionItems
}

// EntryBody is the journal form plus the action item / thankful margin, shared by
// the new-entry page and the dashboard Today tab.
templ EntryBody(c *fiber.Ctx) {
	<div class="body entry-body">
		<div class="journal-form">
			@Form(c, nil)
		</div>
		<div class="right-margin">
			<div class="action-items">
				<h3 class="heading">Take Action</h3>
				@actionItems.Form(c, nil, nil)
				@actionItems.List(c, []*models.ActionItem{}, true)
				<br/>
				if len(getOutstandingActionItems(c)) > 0 {
					<h4>Outstanding:</h4>
					@actionItems.List(c, getOutstandingActionItems(c), false)
				}
			</div>
			<div class="thankfuls">
				<h3 class="heading">Today I'm Thankful For</h3>
				@thankful.Form(c, nil, nil)
				@thankful.List(c, []*models.Thankful{})
			</div>
		</div>
	</div>
}

// DailyReminder renders the day's reminder, if the user has any, above a page's heading.
templ DailyReminder(c *fiber.Ctx) {
	if reminder := reminders.DailyReminder(c); reminder != nil {
		@reminders.Card(c, reminder, false)
	}
}

templ NewPage(c *fiber.Ctx) {
	@web.Base(c, nil) {
		<div id="new-journal-page">
			<a class="back" href={ templ.SafeURL("/journal") }>
				<i class="fas fa-chevron-left" aria-hidden="true"></i>
				Back
			</a>
			@DailyReminder(c)
			<h1 class="heading">New Journal Entry</h1>
			@EntryBody(c)
		</div>
	}
}
