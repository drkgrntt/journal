package journal

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"journal/internal/web/components"
	"time"
)

func journalDate(journal *models.Journal) *time.Time {
	if journal != nil {
		return journal.Date
	}

	t := time.Now()
	return &t
}

func getJournalTypes(c *fiber.Ctx) []*models.JournalType {
	types := utils.GetLocal[[]*models.JournalType](c, "journalTypes")
	return *types
}

func getRatings(c *fiber.Ctx) []*models.Rating {
	ratings := utils.GetLocal[[]*models.Rating](c, "ratings")
	return *ratings
}

func bookmarkedAtLocalized(c *fiber.Ctx, journal *models.Journal) string {
	if journal != nil && journal.BookmarkedAt != nil {
		tz := c.Cookies("timezone", "UTC")
		loc, err := time.LoadLocation(tz)
		if err != nil {
			loc = time.UTC
		}
		localized := time.Date(
			journal.BookmarkedAt.Year(),
			journal.BookmarkedAt.Month(),
			journal.BookmarkedAt.Day(),
			journal.BookmarkedAt.Hour(),
			journal.BookmarkedAt.Minute(),
			journal.BookmarkedAt.Second(),
			journal.BookmarkedAt.Nanosecond(),
			loc,
		)
		return fmt.Sprintf("Bookmarked at %s", localized.Format("01/02/2006 3:04 PM"))
	} else {
		return "Bookmark this journal entry"
	}
}

templ Form(c *fiber.Ctx, journal *models.Journal) {
	<form
		id="journal-form"
		if journal != nil {
			hx-put={ fmt.Sprintf("/api/journal/%s", journal.ID.String()) }
		} else {
			hx-post="/api/journal"
		}
		hx-trigger="submit"
	>
		<div class="field">
			<label class="label" for="date">Date</label>
			@components.DateTimeInput("date", journalDate(journal))
		</div>
		<div class="row">
			<fieldset class="field">
				<legend class="label legend">Rating</legend>
				for _, rating := range getRatings(c) {
					<div class="check-field">
						<input
							id={ fmt.Sprint(rating.ID) }
							type="radio"
							name="rating"
							value={ fmt.Sprint(rating.ID) }
							if journal != nil && journal.RatingID == rating.ID {
								checked
							}
						/>
						<label class="label" for={ fmt.Sprint(rating.ID) }>{ rating.Name }</label>
					</div>
				}
			</fieldset>
			<div class="field">
				<label class="label" for="journalType">Topic</label>
				<select
					name="journalType"
					class="select"
				>
					for _, journalType := range getJournalTypes(c) {
						<option
							value={ fmt.Sprint(journalType.ID) }
							if journal != nil && journal.JournalTypeID == journalType.ID {
								selected
							}
							else
							if journal == nil && journalType.IsDefault() {
								selected
							}
						>
							{ journalType.Name }
						</option>
					}
				</select>
			</div>
		</div>
		<div class="field">
			<span class="label-container">
				<label class="label" for="entry">Entry</label>
				<button
					class="button"
					onclick="event.preventDefault(); textToSpeech(this, 'textarea#entry')"
				>
					<i class="fa fa-microphone"></i>
				</button>
			</span>
			// For writing recognition, reference this
			// https://codepen.io/tomapaunovic/pen/BapVoqb?anon=true&view=pen
			<textarea
				rows="8"
				name="entry"
				class="textarea"
				id="entry"
			>
				if journal != nil {
					{ journal.Entry }
				}
			</textarea>
		</div>
		<div class="checkField">
			<input
				type="checkbox"
				name="addAnotherEntry"
				id="addAnotherEntry"
				value="true"
			/>
			<label class="label" for="addAnotherEntry">Add another entry</label>
		</div>
		<div>
			<div id="action-item-ids">
				if journal != nil {
					for _, actionItem := range journal.ActionItems {
						<input type="hidden" name="actionItemIds[]" value={ actionItem.ID.String() }/>
					}
				}
			</div>
			<div id="thankful-ids">
				if journal != nil {
					for _, thankful := range journal.Thankfuls {
						<input type="hidden" name="thankfulIds[]" value={ thankful.ID.String() }/>
					}
				}
			</div>
			<div class="bottom">
				<input class="button" type="submit"/>
				<label
					for="isBookmarked"
					class="button bookmark-label"
					title={ bookmarkedAtLocalized(c, journal) }
				>
					<i
						class={
							templ.KV("fa-solid", journal != nil && journal.BookmarkedAt != nil),
							templ.KV("fa-regular", journal == nil || journal.BookmarkedAt == nil),
							"fa-bookmark",
						}
					></i>
					<input
						onchange="
						this.previousElementSibling.classList.toggle('fa-regular', !this.checked);
						this.previousElementSibling.classList.toggle('fa-solid', this.checked);
						"
						type="checkbox"
						id="isBookmarked"
						name="isBookmarked"
						if journal != nil && journal.BookmarkedAt != nil {
							checked
						}
					/>
				</label>
			</div>
		</div>
	</form>
}
