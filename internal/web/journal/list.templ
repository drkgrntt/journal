package journal

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"journal/internal/web"
	"journal/internal/web/components"
)

func getJournals(c *fiber.Ctx) []*models.Journal {
	journals := utils.GetLocal[[]*models.Journal](c, "journals")
	return *journals
}

templ loadMore(c *fiber.Ctx) {
	<button
		class="button"
		hx-get={ fmt.Sprintf("/journal/list?topic=%s&sort=%s&page=%d", c.Query("topic"), c.Query("sort"), web.NextPage(c)) }
		hx-target="[journal-list]"
		hx-swap="beforeend"
		hx-swap-oob="true"
		id="journal-next-page"
		if !web.HasMore(c) {
			style="display: none;"
		}
	>
		More
	</button>
}

templ listItemsWithButton(c *fiber.Ctx, includeButton bool) {
	for _, journal := range getJournals(c) {
		<li class="item">
			<a
				class="link"
				href={ templ.SafeURL(fmt.Sprintf("/journal/%s", journal.ID.String())) }
			>
				<h2
					data-datetime={ journal.Date.Format("2006-01-02 15:04 -0700") }
					class="date"
				>
					{ journal.Date.Format("2006-01-02 15:04pm") }
				</h2>
				if journal.BookmarkedAt != nil {
					<i
						title={ bookmarkedAtLocalized(c, journal) }
						class="bookmark fa-solid fa-bookmark"
					></i>
				}
				if journal.IsEncrypted {
					<span class="lock">
						@components.Lock()
					</span>
				}
			</a>
			<div class="info">
				if journal.JournalType != nil && !journal.JournalType.IsCustom() {
					<p class="topic">{ journal.JournalType.Name }</p>
				} else if journal.JournalType.IsCustom() && journal.CustomJournalType != nil {
					<p class="topic">{ journal.CustomJournalType.Name }</p>
				}
				if journal.Rating != nil {
					<p class="rating"><span class={ "color", journal.Rating.Code }>●</span> { journal.Rating.Name }</p>
				}
			</div>
			<p can-blur class="entry">{ utils.SubstringToFullWords(journal.Entry, 130) }</p>
			<div class="actions">
				<span>
					<i class="fa fa-check"></i>
					{ len(journal.ActionItems) }
					actions
				</span>
				<span>
					<i class="fa fa-heart"></i>
					{ len(journal.Thankfuls) }
					thankful
				</span>
			</div>
		</li>
	}
	if includeButton {
		@loadMore(c)
	}
}

templ ListItems(c *fiber.Ctx) {
	@listItemsWithButton(c, true)
}

templ ListPage(c *fiber.Ctx) {
	@web.Base(c) {
		<div id="journal-list-page">
			<div class="top">
				<h1 class="heading">Journal Entries</h1>
				<a href="/journal/new" class="button">
					<i class="fa fa-pen"></i>
				</a>
			</div>
			<div class="sorts">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/journal?topic=%s", c.Query("topic"))) }
					class={ "sort", templ.KV("active", c.Query("sort") == "") }
				>
					List
				</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/journal?sort=date&topic=%s", c.Query("topic"))) }
					class={ "sort", templ.KV("active", c.Query("sort") == "date") }
				>
					By Date
				</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/journal?sort=bookmark&topic=%s", c.Query("topic"))) }
					class={ "sort", templ.KV("active", c.Query("bookmark") == "bookmark") }
				>
					Bookmarked
				</a>
			</div>
			<h4 class="filter-heading">Topics</h4>
			<div class="sorts">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/journal?sort=%s&date=%s", c.Query("sort"), c.Query("date"))) }
					class={ "sort", templ.KV("active", c.Query("topic") == "") }
				>
					All
				</a>
				for _, journalType := range getJournalTypes(c) {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/journal?topic=%s&sort=%s&date=%s", journalType.Code, c.Query("sort"), c.Query("date"))) }
						class={ "sort", templ.KV("active", c.Query("topic") == journalType.Code) }
					>
						{ journalType.Name }
					</a>
				}
			</div>
			<ul class="list" journal-list>
				@listItemsWithButton(c, false)
			</ul>
			@loadMore(c)
			<div class="prev-next">
				if web.PrevDate(c) != "" {
					<a
						class="prev"
						href={ templ.SafeURL(fmt.Sprintf("/journal?topic=%s&date=%s", c.Query("topic"), web.PrevDate(c))) }
					>
						<i class="fa fa-chevron-left"></i>
						Previous
					</a>
				}
				if web.NextDate(c) != "" {
					<a
						class="next"
						href={ templ.SafeURL(fmt.Sprintf("/journal?topic=%s&date=%s", c.Query("topic"), web.NextDate(c))) }
					>
						Next
						<i class="fa fa-chevron-right"></i>
					</a>
				}
			</div>
		</div>
	}
}
