package journal

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/web"
	"journal/internal/web/actionItems"
	"journal/internal/web/components"
	"journal/internal/web/thankful"
)

templ View(c *fiber.Ctx, journal *models.Journal) {
	<div class="journal">
		<div class="actions">
			<a class="back" href={ templ.SafeURL("/journal") }>
				<i class="fa fa-chevron-left"></i>
				Back
			</a>
			@components.KebabMenu() {
				<div class="kebab-content">
					<a
						class="action-link"
						href={ templ.SafeURL(fmt.Sprintf("/journal/%s/edit", journal.ID.String())) }
					>
						Edit
					</a>
					<a
						class="action-link"
						href="#"
						hx-confirm="Are you sure?"
						hx-delete={ fmt.Sprintf("/api/journal/%s", journal.ID.String()) }
					>
						Delete
					</a>
				</div>
			}
		</div>
		<div class="top">
			<h2
				class="heading"
				data-datetime={ journal.Date.Format("2006-01-02 15:04 -0700") }
			>
				{ journal.Date.Format("2006-01-02 15:04pm") }
			</h2>
			if journal.BookmarkedAt != nil {
				<i
					title={ bookmarkedAtLocalized(c, journal) }
					class="bookmark fa-solid fa-bookmark"
				></i>
			}
			if journal.IsEncrypted {
				<span class="encrypted">
					@components.Lock()
				</span>
			}
		</div>
		<div class="info">
			if journal.JournalType != nil && !journal.JournalType.IsCustom() {
				<p class="topic">{ journal.JournalType.Name }</p>
			} else if journal.JournalType.IsCustom() && journal.CustomJournalType != nil {
				<p class="topic">{ journal.CustomJournalType.Name }</p>
			}
			if journal.Rating != nil {
				<p class="rating"><span class={ "color", journal.Rating.Code }>●</span> { journal.Rating.Name }</p>
			}
		</div>
		<p can-blur class="entry">{ journal.Entry }</p>
		<div class="pagination">
			if journal.PreviousJournal != nil {
				<a
					class="previous"
					href={ templ.SafeURL(fmt.Sprintf("/journal/%s", journal.PreviousJournal.ID.String())) }
				>
					<i class="fa fa-chevron-left"></i>
					Previous
				</a>
			}
			if journal.NextJournal != nil {
				<a
					class="next"
					href={ templ.SafeURL(fmt.Sprintf("/journal/%s", journal.NextJournal.ID.String())) }
				>
					Next
					<i class="fa fa-chevron-right"></i>
				</a>
			}
		</div>
	</div>
}

templ ViewPage(c *fiber.Ctx) {
	@web.Base(c, nil) {
		<div id="journal-view-page">
			<div>
				@View(c, getJournal(c))
			</div>
			<div class="right-margin">
				<div class="action-items">
					@actionItems.Combined(c, getJournal(c))
				</div>
				<div class="thankfuls">
					@thankful.Combined(c, getJournal(c))
				</div>
			</div>
		</div>
	}
}
