package emails

import "strings"

const (
	REMINDER_EMAIL = "reminder-email"
)

const (
	DefaultReminderEmailLine    = "Whenever you're ready, the journal is here."
	DefaultReminderEmailSubject = "A moment for yourself"
	reminderSubjectMaxRunes     = 60
)

type ReminderEmailVariables struct {
	RootUrl string
	// Message is the user's own short note; empty means the default line.
	Message string
}

func (v *ReminderEmailVariables) Line() string {
	if v.Message == "" {
		return DefaultReminderEmailLine
	}
	return v.Message
}

// Subject is the default subject, or the first line of the user's own message
// (shortened) so a custom message replaces the default everywhere instead of
// sitting beside it.
func (v *ReminderEmailVariables) Subject() string {
	if v.Message == "" {
		return DefaultReminderEmailSubject
	}
	line := strings.TrimSpace(strings.SplitN(strings.TrimSpace(v.Message), "\n", 2)[0])
	if line == "" {
		return DefaultReminderEmailSubject
	}
	runes := []rune(line)
	if len(runes) > reminderSubjectMaxRunes {
		return strings.TrimSpace(string(runes[:reminderSubjectMaxRunes-1])) + "…"
	}
	return line
}

templ ReminderEmail(vars *ReminderEmailVariables) {
	<div style="font-family: sans-serif; text-align: center; white-space: pre-line">
		<p>{ vars.Line() }</p>
		<br/>
		<!-- templ.SafeURL: RootUrl is server config, not user input -->
		<a
			href={ templ.SafeURL(vars.RootUrl + "/dashboard") }
			style="
			text-decoration: none;
			color: #fff;
			background-color: #000;
			padding: 10px 20px;
			border-radius: 5px;
			"
		>Open Contour Journal</a>
	</div>
}
