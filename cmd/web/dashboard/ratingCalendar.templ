package dashboard

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"journal/internal/models"
	"journal/internal/utils"
	"time"
)

var weekdays = map[time.Weekday]int{
	time.Sunday:    1,
	time.Monday:    2,
	time.Tuesday:   3,
	time.Wednesday: 4,
	time.Thursday:  5,
	time.Friday:    6,
	time.Saturday:  7,
}

func weeksInMonth(month time.Month, year int) [][]int {
	var weeks [][]int
	t := time.Date(year, month, 1, 0, 0, 0, 0, time.UTC)
	var monthStarted bool
	for t.Month() == month {
		week := make([]int, 7)
		for i := range week {
			if t.Month() == month && (monthStarted || i+1 == weekdays[t.Weekday()]) {
				week[i] = t.Day()
				monthStarted = true
			}

			if monthStarted {
				t = t.AddDate(0, 0, 1)
			}
		}
		weeks = append(weeks, week)
	}
	return weeks
}

func month(ctx *fiber.Ctx) string {
	month := ctx.QueryInt("month")
	if month == 0 {
		return time.Now().Format("January")
	}
	return time.Month(month).String()
}

func year(ctx *fiber.Ctx) string {
	year := ctx.Query("year")
	if year == "" {
		year = time.Now().Format("2006")
	}
	return year
}

func current(ctx *fiber.Ctx) time.Time {
	month := ctx.QueryInt("month")
	year := ctx.QueryInt("year")
	tz := ctx.Cookies("tz")
	loc, err := time.LoadLocation(tz)
	if err != nil {
		loc = time.UTC
	}
	if month == 0 || year == 0 {
		return time.Now()
	}
	return time.Date(year, time.Month(month), 1, 0, 0, 0, 0, loc)
}

templ RatingCalendar(c *fiber.Ctx) {
	<div class="rating-calendar">
		<div class="legend">
			<span><span class="dot awful">●</span> Awful</span>
			<span><span class="dot bad">●</span> Bad</span>
			<span><span class="dot fine">●</span> Fine</span>
			<span><span class="dot good">●</span> Good</span>
			<span><span class="dot great">●</span> Great</span>
			<span><span class="dot no-journals">●</span> No Journals</span>
		</div>
		<table>
			<caption>
				<a
					href="#"
					class="button"
					hx-get={ templ.SafeURL(fmt.Sprintf("/dashboard/calendar?month=%d&year=%d", int(current(c).AddDate(0, -1, 0).Month()), current(c).AddDate(0, -1, 0).Year())) }
					hx-target=".rating-calendar"
					hx-swap="outerHTML"
				>
					<i class="fa-solid fa-chevron-left"></i>
				</a>
				{ month(c) } { year(c) }
				<a
					href="#"
					class="button"
					hx-get={ templ.SafeURL(fmt.Sprintf("/dashboard/calendar?month=%d&year=%d", int(current(c).AddDate(0, 1, 0).Month()), current(c).AddDate(0, 1, 0).Year())) }
					hx-target=".rating-calendar"
					hx-swap="outerHTML"
				>
					<i class="fa-solid fa-chevron-right"></i>
				</a>
			</caption>
			<thead>
				<tr>
					<th>Su</th>
					<th>Mo</th>
					<th>Tu</th>
					<th>We</th>
					<th>Th</th>
					<th>Fr</th>
					<th>Sa</th>
				</tr>
			</thead>
			<tbody>
				for _, week := range weeksInMonth(current(c).Month(), current(c).Year()) {
					<tr>
						for _, day := range week {
							<td
								if day != 0 {
									data-calendar-date={ time.Date(current(c).Year(), current(c).Month(), day, 0, 0, 0, 0, time.UTC).Format("2006-01-02") }
								}
							>
								if day != 0 {
									{ fmt.Sprint(day) }
								}
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
		@templ.JSONScript("calendar-journals", utils.GetLocal[[]*models.Journal](c, "journals"))
		<script src="/assets/js/components/ratingCalendar.js" type="module"></script>
	</div>
}
